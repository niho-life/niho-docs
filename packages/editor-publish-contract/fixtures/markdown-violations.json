{
  "description": "Markdown outside the subset. Expected reasons live in v1/cases.json.",
  "cases": [
    { "id": "md-html-block", "markdown": "<script>alert(1)</script>" },
    { "id": "md-html-inline", "markdown": "Hello <b>world</b>" },
    { "id": "md-autolink", "markdown": "<https://example.com/>" },
    { "id": "md-entity", "markdown": "Tom &amp; Jerry" },
    { "id": "md-underscore", "markdown": "_italic_" },
    { "id": "md-backtick", "markdown": "use `code` here" },
    { "id": "md-code-fence", "markdown": "```\nplain\n```" },
    { "id": "md-strike", "markdown": "~~old~~" },
    { "id": "md-quote", "markdown": "> quoted" },
    { "id": "md-thematic-break", "markdown": "Above\n\n---\n\nBelow" },
    { "id": "md-thematic-break-stars", "markdown": "***" },
    { "id": "md-setext-heading", "markdown": "Title\n===" },
    { "id": "md-heading-level-1", "markdown": "# Title" },
    { "id": "md-heading-level-4", "markdown": "#### Title" },
    { "id": "md-nested-list", "markdown": "- outer\n  - inner" },
    { "id": "md-indented-code", "markdown": "    indented" },
    { "id": "md-star-bullet", "markdown": "* item" },
    { "id": "md-paren-ordered", "markdown": "1) item" },
    { "id": "md-link-http", "markdown": "[a](http://example.com/)" },
    { "id": "md-link-mailto", "markdown": "[mail](mailto:someone@example.com)" },
    { "id": "md-link-javascript", "markdown": "[x](javascript:alert(1))" },
    { "id": "md-link-data", "markdown": "[x](data:text/html,hi)" },
    { "id": "md-link-protocol-relative", "markdown": "[x](//evil.example.com/)" },
    { "id": "md-link-entity", "markdown": "[x](/&#47;evil.example.com/)" },
    { "id": "md-link-title", "markdown": "[x](/path \"title\")" },
    { "id": "md-inline-image", "markdown": "See ![alt](https://example.com/a.png) here" },
    { "id": "md-image-http", "markdown": "![alt](http://example.com/a.png)" },
    { "id": "md-image-site-path", "markdown": "![alt](/a.png)" },
    { "id": "md-reference-link", "markdown": "[x][ref]" },
    { "id": "md-link-definition", "markdown": "[ref]: https://example.com/" },
    { "id": "md-footnote", "markdown": "Text[^1]" },
    { "id": "md-table", "markdown": "| a | b |\n| - | - |" },
    { "id": "md-bare-http", "markdown": "Visit http://example.com/ today" },
    { "id": "md-bare-javascript", "markdown": "javascript:alert(1)" },
    { "id": "md-hard-break", "markdown": "line\\\nnext" },
    { "id": "md-trailing-spaces", "markdown": "line  \nnext" },
    { "id": "md-unclosed-note", "markdown": ":::note\ntext" },
    { "id": "md-unknown-container", "markdown": ":::warning\ntext\n:::" },
    { "id": "md-heading-in-note", "markdown": ":::note\n## Title\n:::" },
    { "id": "md-control-character", "markdown": "a\tb" }
  ]
}
