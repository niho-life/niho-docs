{
  "name": "@niho/editor-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "editor.niho.life（NIHO editor）の Web。ページを作って書く。",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "sh scripts/start-standalone.sh",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:startup": "node --test test/startup-guard.test.mjs",
    "test:e2e": "node --test test/e2e-smoke.test.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@niho/docs-core": "file:../../packages/docs-core",
    "@niho/editor-store": "file:../../packages/editor-store",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "clsx": "^2.1.1",
    "lucide-react": "1.58.0",
    "markdown-it": "^14.3.2",
    "next": "16.3.8",
    "niho-docs-ui": "file:../../packages/docs-ui",
    "niho-ui": "file:../../packages/ui",
    "pg": "8.23.1",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-search": "1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
